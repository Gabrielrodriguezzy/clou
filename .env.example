# Clou - Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://clou:clou_secret@postgres:5432/clou

# Redis
REDIS_URL=redis://redis:6379/0

# Security
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mercado Pago (necessário apenas quando PIX_PROVIDER=mercadopago)
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# MERCADO_PAGO_INTEGRATOR_ID=
# MERCADO_PAGO_SANDBOX=true

# Pix Provider: "mock" (simulado, padrão) ou "mercadopago" (real)
PIX_PROVIDER=mock

# SMM Providers
SMM_PROVIDER_API_URL=https://example-smm-panel.com/api/v2
SMM_PROVIDER_API_KEY=your_api_key

# App
APP_NAME=Clou
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=true
